# GEMINI_API_KEY: Required for Gemini AI API calls (Profile Inspector, Search Analyst, Draft generator).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID from Google Cloud Console Credentials.
# Required for connecting the Google Business Profile account.
GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: Google OAuth 2.0 Web Client Secret from Google Cloud Console Credentials.
GOOGLE_CLIENT_SECRET=""

# OWNER_EMAIL: Configured private owner email allowed to access this Phase 1 application.
# Defaults to arthurscreatives@gmail.com
OWNER_EMAIL="arthurscreatives@gmail.com"

# Vertex AI on Google Cloud Configuration
# When running on Cloud Run, the application can authenticate directly using its attached
# service account with roles/aiplatform.user without needing an API key.
GOOGLE_GENAI_USE_VERTEXAI="false"
GOOGLE_CLOUD_PROJECT=""
VERTEX_LOCATION="us-central1"
GEMINI_MODEL="gemini-3.8-flash"

# STRIPE_SECRET_KEY: Secret key for Stripe Hosted Checkout & Customer Portal
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Secret for verifying inbound webhook signatures (from Stripe Dashboard or Stripe CLI)
STRIPE_WEBHOOK_SECRET=""

# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: Public key for client-side Stripe elements
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""


